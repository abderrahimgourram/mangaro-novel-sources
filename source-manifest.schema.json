{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mangaro novel rules engines 1–2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "revision",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "engineVersion": {
      "enum": [
        1,
        2
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "selectors"
        ],
        "properties": {
          "id": {
            "enum": [
              "novel.kolnovel",
              "novel.cenele",
              "novel.sunovels",
              "novel.seanovel"
            ]
          },
          "domain": {
            "enum": [
              "kolnovel.com",
              "cenele.com",
              "sunovels.com",
              "seanovel.org"
            ]
          },
          "selectors": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "catalogCards": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "catalogTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "catalogCover": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "detailsTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "detailsCover": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "genres": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "chapterLinks": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "chapterTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "originalTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    }
  }
}
