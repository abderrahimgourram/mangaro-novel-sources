{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mangaro novel rules engine 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engineVersion", "revision", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "engineVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "sources": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "domain", "selectors"],
        "properties": {
          "id": {"enum": ["novel.kolnovel", "novel.cenele", "novel.sunovels", "novel.seanovel"]},
          "domain": {"enum": ["kolnovel.com", "cenele.com", "sunovels.com", "seanovel.org"]},
          "selectors": {"type": "object", "required": ["text"], "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      }
    }
  }
}
