{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed Mangaro novel update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "revision",
    "envelopePath",
    "sha256",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "engineVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "envelopePath": {
      "type": "string",
      "pattern": "^published/rules-[1-9][0-9]*\\.json$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
